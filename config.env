# ==============================================================================
# Strata Colab Desktop — Configuration
# ==============================================================================
# Sourced by all management scripts.
# To override settings or store private values (such as API_KEY or HF_TOKEN),
# create a `config.local.env` file in this directory (it is gitignored).

# ----- Google Colab Runtime -----
COLAB_SESSION=strata          # Colab CLI session name (also passed to ssh_config ProxyCommand)
GPU=G4                        # Default preferred GPU: G4 / H100 / A100 / L4 / T4
                              #   G4   = NVIDIA RTX PRO 6000 Blackwell (98 GB VRAM / 176 GB System RAM)
                              #   H100 = NVIDIA H100 (80 GB VRAM / ~167 GB System RAM)
                              #   A100 = NVIDIA A100 (40-80 GB VRAM / ~83-167 GB System RAM)
                              #   L4   = NVIDIA L4   (23 GB VRAM / 52 GB System RAM)
                              #   T4   = NVIDIA T4   (15 GB VRAM / 12.7-51 GB System RAM)
ASK_GPU=1                     # 1 = Show interactive eligible GPU selector at startup & fallback on 503 capacity errors
HIGH_MEM=1                    # 1 = Request High-RAM shape where supported (A100, T4). G4/H100/L4 are High-RAM by default
EXPECT_GPU_REGEX='G4|RTX PRO 6000|Blackwell|H100|A100|L4|T4'
ON_GPU_MISMATCH=ask           # Action if allocated GPU does not match EXPECT_GPU_REGEX: ask / stop / continue

# ----- Strata Application & Model Settings (Colab VM) -----
STRATA_REPO=https://github.com/Niko1221/Strata.git
UI_MODE=desktop               # desktop = Launch full Strata Desktop App UI (app/host)
                              # cli     = Launch lightweight Strata CLI inference server only
MODEL=IQ3_S                   # Default Strata model size:
                              #   Qwen3.8-Flash-Next : Q2_0 / IQ2_XS / IQ3_XXS / IQ3_S
                              #   Qwen3.8-Coder      : IQ1_M (with MODEL_FAMILY='coder')
                              #   Qwen3.6-35B-A3B    : UD-Q4_K_XL / UD-Q6_K_XL / Q8_0 (with MODEL_FAMILY='qwen36')
                              #   Unsloth Qwen3.8    : UD-IQ4_XS / UD-Q4_K_XL / UD-Q5_K_XL / UD-Q6_K_XL / Q8_0 (MODEL_FAMILY='unsloth')
MODEL_FAMILY=''               # Model family: qwen / qwen36 / swift / coder / unsloth / gyro / nvfp4 (empty = Strata default)
ASK_MODEL=1                   # 1 = Show interactive model selector at startup (badges models cached in Google Drive)
CONTEXT=262144                # Context window in tokens (262144 = 256K full native context)
TUNE_ON_START=0               # 1 = Automatically run Strata hardware calibration/tuning before loading the model on start

# ----- Custom Hugging Face GGUF Repository (Optional) -----
# Set MODEL_REPO to download and run a custom GGUF repository from Hugging Face.
# Validated with `./setup.sh --inspect` before downloading. Put HF_TOKEN in `config.local.env` for private repos.
MODEL_REPO=''                 # Example: someone/Qwen3.8-Flash-Next-GGUF (leave empty for official Strata models)
MODEL_FILES=''                # Glob pattern to download (empty = "*<MODEL>*.gguf")
MODEL_REVISION=''             # Branch, tag, or commit hash (empty = default branch)

# ----- Remote VM Paths & Google Drive Persistent Cache -----
REMOTE_PORT=8089              # Port inside the Colab VM (port 8080 is used by Colab's internal Jupyter server)
API_KEY=                      # Optional API key (usually not needed since access is restricted to the local SSH tunnel)
STRATA_EXTRA_ARGS=''          # Extra flags passed to setup.sh (e.g., "--vision yes" or "--kv int8")
REMOTE_DIR=/content/Strata
DATA_DIR=/content/Strata-data # Fast local NVMe SSD storage on the Colab VM
USE_DRIVE=1                   # 1 = Mount Google Drive to persist downloaded models & restore them on future runs
DRIVE_MOUNT=/content/drive
DRIVE_DATA_DIR=/content/drive/MyDrive/Strata-data
REMOTE_LOG=/content/strata-setup.log

# ----- Local Windows / WSL Tunnel & Health Monitoring -----
LOCAL_PORT=8080               # Local port forwarded to the Colab VM (http://localhost:8080)
OPEN_BROWSER=1                # 1 = Automatically open the Strata UI in your default Windows browser when ready
HEALTH_TIMEOUT_MIN=60         # Maximum minutes to wait for initial model download & startup
POLL_SEC=20                   # Interval (seconds) between startup health polls
SETUP_RETRIES=2               # Number of automatic setup retries on the Colab VM if startup fails
WATCH_SEC=30                  # Interval (seconds) for tunnel & server health watchdog checks
